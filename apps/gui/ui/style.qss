QMainWindow {
    background-color: #121418;
}

/* Color global para las etiquetas de texto */
QLabel {
    color: #ffffff;
}

/* Etiquetas secundarias de información */
#labelSesionInfo, #labelDireccion, #labelPrecioTotal {
    color: #abb2bf;
}

/* Quitar fondos grises/blancos del ScrollArea */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

#scrollAreaWidgetContentsSesiones {
    background-color: transparent;
}

/* Listas con bordes redondeados y fondo pizarra */
QListWidget {
    background-color: #1e222b;
    border: 1px solid #282c34;
    border-radius: 12px;
    color: #ffffff;
    padding: 10px;
}

QListWidget::item:hover {
    background-color: #282c34;
    border-radius: 8px;
}

/* Estilo para los botones de atrás */
QPushButton#botonAtrasPeliculas, 
QPushButton#botonAtrasSesiones, 
QPushButton#botonAtrasSala {
    background-color: #1e222b;
    border: 1px solid #3e4452;
    border-radius: 6px;
    color: #ffffff;
    padding: 5px 10px;
    font-weight: bold;
}

QPushButton#botonAtrasPeliculas:hover, 
QPushButton#botonAtrasSesiones:hover, 
QPushButton#botonAtrasSala:hover {
    background-color: #00f0b5;
    color: #121418;
    border: 1px solid #00f0b5;
}

/* Estilo para las butacas del cine */
QPushButton#botonButaca {
    background-color: #2ecc71;
    border: 1px solid #27ae60;
    border-radius: 4px;
}

QPushButton#botonButaca:hover {
    background-color: #00f0b5;
    border: 1px solid #00d09c;
}

QPushButton#botonButaca:disabled {
    background-color: #e74c3c;
    border: 1px solid #c0392b;
}

/* Pantalla del cine estilo mockup */
#labelPantalla {
    color: #abb2bf;
    background-color: #1e222b;
    border: 1px solid #3e4452;
    border-radius: 12px;
    padding: 8px;
    letter-spacing: 4px;
    font-size: 11px;
}

/* Estilo para el contenedor del ticket de compra */
QFrame#frameTicket {
    background-color: #1e222b;
    border: 2px solid #282c34;
    border-radius: 16px;
    padding: 15px;
}

/* Estilo del código QR dentro del ticket */
QLabel#labelQR {
    background-color: #ffffff;
    border-radius: 10px;
    padding: 8px;
}

/* Botón de volver al inicio de página final */
QPushButton#botonInicio {
    background-color: #00f0b5;
    color: #121418;
    border: 1px solid #00f0b5;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#botonInicio:hover {
    background-color: #00d09c;
    border: 1px solid #00d09c;
}