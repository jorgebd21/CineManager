                 <widget class="QLabel" name="labelQRInstruccion">
                  <property name="text">
                   <string>&lt;html&gt;&lt;body&gt;&lt;p align=&quot;center&quot;&gt;&lt;b style=&quot;color:#E5C07B; font-size:10px; letter-spacing:1px;&quot;&gt;ACCESO DIGITAL DIRECTO&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#8C91A4; font-size:10px;&quot;&gt;Presenta este código en el torno de la sala&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="alignment">
                   <set>Qt::AlignCenter</set>
                  </property>
                  <property name="wordWrap">
                   <bool>true</bool>
                  </property>
                 </widget>
                </item>
               </layout>
              </widget>
             </item>

             <!-- Linea divisoria vertical punteada / hundida -->
             <item>
              <widget class="QFrame" name="lineaDivisoria">
               <property name="frameShape">
                <enum>QFrame::VLine</enum>
               </property>
               <property name="frameShadow">
                <enum>QFrame::Sunken</enum>
               </property>
              </widget>
             </item>

             <!-- Columna Detalles de la Compra -->
             <item>
              <widget class="QLabel" name="labelTicketDetalles">
               <property name="text">
                <string>Detalles de la compra...</string>
               </property>
               <property name="alignment">
                <set>Qt::AlignLeft|Qt::AlignVCenter</set>
               </property>
               <property name="wordWrap">
                <bool>true</bool>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>

          <item>
           <spacer name="spacerTicketDer">
            <property name="orientation">
             <enum>Qt::Horizontal</enum>
            </property>
           </spacer>
          </item>
         </layout>
        </item>

        <!-- Boton volver al inicio -->
        <item>
         <layout class="QHBoxLayout" name="layoutBotonInicio">
          <item>
           <spacer name="spacerBotonIzq">
            <property name="orientation">
             <enum>Qt::Horizontal</enum>
            </property>
           </spacer>
          </item>
          <item>
           <widget class="QPushButton" name="botonInicio">
            <property name="text">
             <string>Volver al Inicio</string>
            </property>
            <property name="minimumSize">
             <size>
              <width>240</width>
              <height>42</height>
             </size>
            </property>
           </widget>
          </item>
          <item>
           <spacer name="spacerBotonDer">
            <property name="orientation">
             <enum>Qt::Horizontal</enum>
            </property>
           </spacer>
          </item>
         </layout>
        </item>

        <!-- Espaciador inferior para centrar armónicamente -->
        <item>
         <spacer name="verticalSpacerTicketBottom">
          <property name="orientation">
           <enum>Qt::Vertical</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>20</width>
            <height>20</height>
           </size>
          </property>
         </spacer>
        </item>

       </layout>
      </widget>
      
     </widget>
    </item>
   </layout>
  </widget>
